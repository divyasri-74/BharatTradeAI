# BharatTrade AI — Secure Backend Environment Configuration
# Never commit real keys to version control.

# Google Gemini API key (from Google AI Studio)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Allowed Frontend Origins for CORS (comma-separated, no quotes)
# In production, replace with your Vercel deployment URL:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Port for local development (Render injects its own PORT automatically)
PORT=8000
