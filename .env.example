# BharatTrade AI — Frontend Environment Configuration
# Used by Vite during development and production build.
# Copy this file to .env for local development.

# 1. Supabase Project Configuration (Optional: runs in Local Storage Guest Mode if omitted)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 2. Backend FastAPI Gateway URL (Render deployment or localhost)
# Local development default: http://localhost:8000
# Production on Vercel: set this to your Render service URL (e.g. https://bharattrade-backend.onrender.com)
VITE_BACKEND_URL=http://localhost:8000

# Security note: Do not store service-role keys or private broker secrets in frontend VITE_* variables.
